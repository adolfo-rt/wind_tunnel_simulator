{
  "name": "wind-tunnel-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive 3D wind tunnel simulator for commercial airliners",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "shots": "node scripts/shoot.mjs",
    "views": "node scripts/views.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
